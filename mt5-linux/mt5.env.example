# mt5-linux/mt5.env.example — template. Copy to mt5.env (gitignored) and fill in.
MT5_LOGIN=12345678
MT5_PASSWORD=your-password-here
MT5_SERVER=YourBroker-MT5Server

# Optional overrides (defaults live in the scripts themselves):
# MT5_STACK_DIR=/home/z/mt5-stack
# WINE_ROOT=/home/z/mt5-restore/wine-root
# MT5_DISPLAY=:99
# MT5_MCP_URL=http://127.0.0.1:22346/mcp
# MT5_MCP_KEY_FILE=/home/z/mt5-stack/mcp_key.txt
