# Shared env template (documentation copy).
# Real, consumed templates live at frontend/.env.example and backend/.env.example.
# NEVER commit real .env files (see .gitignore).

# ---- frontend/.env ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=          # empty in dev -> same-origin via Vite proxy (D-005)
VITE_WS_URL=

# ---- backend/.env ----
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
FERNET_KEY=            # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADMIN_EMAILS=
DATA_SOURCE=live      # live (DEFAULT: free real-time gold APIs, D-030) | mock | mt5 (Windows)
LIVE_POLL_SECONDS=2.0 # live feed poll cadence (Binance PAXG -> gold-api fallback)
FMP_API_KEY=
MT5_TERMINAL_PATH=
STATIC_DIR=            # Railway image sets /app/static (D-016); unset in dev

# ---- Railway single-service (Dockerfile, D-016) ----
# PORT is injected by Railway. VITE_* vars double as Docker build args so the
# SPA picks them up at build time. See README "Deploy to Railway".
