# Shared env template (documentation copy).
# Real, consumed templates live at frontend/.env.example and backend/.env.example.
# NEVER commit real .env files (see .gitignore).

# ---- frontend/.env ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=          # empty in dev -> same-origin via Vite proxy (D-005)
VITE_WS_URL=

# ---- backend/.env ----
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
FERNET_KEY=            # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADMIN_EMAILS=
DATA_SOURCE=mock       # mock | mt5  (SPEC C7)
FMP_API_KEY=
MT5_TERMINAL_PATH=
