# Copy to .env and adjust if needed.

# Next.js
NEXT_TELEMETRY_DISABLED=1

# market-service (mini-services/market-service)
# Path to the MetaTrader 5 terminal MCP bearer key file.
# The terminal must run with its MCP server enabled on 127.0.0.1:22346.
MT5_MCP_KEY_FILE=/home/z/mt5-stack/mcp_key.txt
MT5_MCP_URL=http://127.0.0.1:22346/mcp

# --- Data-source ladder (in priority order) -----------------------------
# 1. LOCAL MT5 terminal (MCP bridge above) — used when present.
# 2. REMOTE MT5 bridge — the user-directed AURUM Terminal source
#    (https://u1m7j8csutd1-d.space-z.ai) hosting the SAME Exness terminal;
#    real-time broker bid/ask + candles as JSON. Failover: if it goes dark,
#    markets fall back to the web exchanges within ~15s and upgrade back
#    automatically (60s probes + 2min anti-flap cooldown).
REMOTE_MT5_URL=https://u1m7j8csutd1-d.space-z.ai
REMOTE_MT5_PORT=3031
# 3. WEB-LIVE exchanges (always-on last resort, no config needed):
#    Binance PAXG/USDT (gold) + BTC/USDT order books (WebSocket, real-time),
#    NYMEX WTI (CL=F) + CME Nasdaq-100 (NQ=F) futures via Yahoo (~10 min delay).

# Terminal auto-login (used by mt5-linux/ensure-stack.sh — see README)
MT5_LOGIN=414350770
MT5_SERVER=Exness-MT5Trial6
# NOTE: set MT5_PASSWORD via your secret env (Railway dashboard / local .env) — never commit it
# --- Cloud WebSocket (optional): point the frontend WS at a tunnelled market-service ---
# NEXT_PUBLIC_MARKET_WS_URL=https://mt5.example.com
