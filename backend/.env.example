# Backend environment (SPEC §11). Copy to .env — NEVER commit the real .env.
# Phase 0: every value is optional; the app boots in degraded mode without them.

# Supabase Postgres (direct connection). postgres:// is normalized automatically.
DATABASE_URL=

# Supabase project (token verification — Phase 1)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Fernet key for MT5 password encryption at rest (Phase 2).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Comma-separated emails promoted to admin at startup (Phase 1, SPEC §6)
ADMIN_EMAILS=

# Data source: mock | mt5  (SPEC C7)
DATA_SOURCE=mock

# External services
FMP_API_KEY=

# Windows-only: path to the MT5 terminal (Phase 2)
MT5_TERMINAL_PATH=

# CORS origins for the FastAPI app (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
